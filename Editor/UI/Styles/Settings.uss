/* 设置页面：服务器配置、高亮设置和通用反馈状态。 */
.config-list-scroll {
    background-color: rgb(37, 37, 37);
    border-width: 1px;
    border-color: rgb(68, 68, 68);
    border-radius: 4px;
    min-height: 120px;
    max-height: 200px;
    overflow: scroll;
}

.config-list-content {
    padding: 5px;
}

.config-list-item {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 8px 10px;
    margin-bottom: 4px;
    background-color: rgb(45, 45, 45);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgb(68, 68, 68);
}

.config-list-item:hover {
    background-color: rgb(61, 61, 61);
    border-color: rgb(147, 122, 85);
}

.config-list-item-selected {
    background-color: rgb(61, 53, 40);
    border-color: rgb(147, 122, 85);
}

.config-item-name {
    color: rgb(255, 255, 255);
    font-size: 13px;
    -unity-font-style: bold;
}

.config-item-url {
    color: rgb(136, 136, 136);
    font-size: 11px;
    margin-top: 2px;
}

.config-item-info {
    flex-grow: 1;
}

.config-item-actions {
    flex-direction: row;
    align-items: center;
}

.config-item-connect-button {
    min-width: 82px;
    margin-right: 6px;
    padding: 5px 10px;
    background-color: rgb(52, 52, 52);
    color: rgb(205, 205, 205);
    border-width: 1px;
    border-color: rgb(82, 82, 82);
    border-radius: 4px;
    -unity-font-style: bold;
}

.config-item-connect-button:hover {
    background-color: rgb(62, 62, 62);
    border-color: rgb(112, 112, 112);
}

.config-connect-connecting {
    color: rgb(211, 177, 112);
    border-color: rgb(147, 122, 85);
}

.config-connect-connected {
    background-color: rgb(45, 74, 62);
    color: rgb(111, 207, 151);
    border-color: rgb(72, 125, 95);
}

.config-connect-failed {
    background-color: rgb(74, 45, 45);
    color: rgb(224, 112, 112);
    border-color: rgb(128, 68, 68);
}

.config-item-edit-button {
    background-color: rgb(147, 122, 85);
    color: white;
    border-width: 0;
    border-radius: 4px;
    padding: 5px 10px;
    -unity-font-style: bold;
}

.config-item-edit-button:hover {
    background-color: rgb(166, 138, 98);
}

.add-config-button {
    margin-top: 10px;
    height: 35px;
    background-color: rgb(45, 74, 62);
    color: rgb(111, 207, 151);
    border-width: 1px;
    border-color: rgb(61, 90, 78);
    border-radius: 4px;
    -unity-font-style: bold;
}

.add-config-button:hover {
    background-color: rgb(61, 90, 78);
    border-color: rgb(111, 207, 151);
}

.config-editor-section {
    background-color: rgb(37, 37, 37);
    border-width: 1px;
    border-color: rgb(147, 122, 85);
    border-radius: 4px;
    padding: 15px;
    margin-top: 15px;
}

.config-field {
    margin-bottom: 10px;
}

.highlighter-settings-section {
    background-color: rgb(37, 37, 37);
    border-width: 1px;
    border-color: rgb(68, 68, 68);
    border-radius: 4px;
    padding: 12px;
}

.highlighter-control {
    min-height: 24px;
}

.highlighter-field {
    flex-grow: 1;
    min-width: 200px;
}

.field-label {
    color: rgb(204, 204, 204);
    font-size: 12px;
    margin-bottom: 4px;
}

.config-button-row {
    flex-direction: row;
    margin-top: 15px;
}

.paste-from-clipboard-button {
    height: 32px;
    margin-top: 2px;
    margin-bottom: 4px;
    background-color: rgb(58, 45, 74);
    color: rgb(214, 190, 230);
    border-color: rgb(109, 88, 140);
    border-width: 1px;
    border-radius: 4px;
    -unity-font-style: bold;
}

.paste-from-clipboard-button:hover {
    background-color: rgb(74, 57, 94);
    color: rgb(235, 220, 245);
    border-color: rgb(151, 116, 185);
}

.paste-from-clipboard-button:active {
    background-color: rgb(48, 38, 62);
    border-color: rgb(181, 145, 211);
}

.test-connect-button {
    background-color: rgb(52, 94, 110);
    color: rgb(160, 235, 235);
    border-color: rgb(70, 90, 105);
    border-width: 1px;
    border-radius: 4px;
}

.test-connect-button:hover {
    background-color: rgb(68, 115, 130);
    border-color: rgb(120, 190, 220);
}

Button.test-connect-button.unity-disabled {
    background-color: rgb(68, 90, 105);
    color: rgb(150, 190, 200);
    border-color: rgb(90, 115, 130);
    opacity: 0.85;
}

.save-button {
    background-color: rgb(45, 74, 62);
    color: rgb(111, 207, 151);
    border-color: rgb(61, 90, 78);
}

.save-button:hover {
    background-color: rgb(61, 90, 78);
    border-color: rgb(111, 207, 151);
}

.delete-button {
    background-color: rgb(74, 45, 45);
    color: rgb(207, 111, 111);
    border-color: rgb(90, 61, 61);
}

.delete-button:hover {
    background-color: rgb(90, 61, 61);
    border-color: rgb(207, 111, 111);
}

.cancel-button {
    background-color: rgb(58, 58, 58);
    color: rgb(153, 153, 153);
    border-color: rgb(74, 74, 74);
}

.cancel-button:hover {
    background-color: rgb(74, 74, 74);
    border-color: rgb(153, 153, 153);
}

.help-box {
    background-color: rgb(61, 53, 40);
    border-width: 1px;
    border-color: rgb(147, 122, 85);
    border-radius: 4px;
    padding: 10px;
    color: rgb(204, 204, 204);
    font-size: 11px;
}

.error-text {
    color: rgb(207, 111, 111);
    font-size: 12px;
}

.success-text {
    color: rgb(111, 207, 151);
    font-size: 12px;
}

.empty-state {
    padding: 20px;
    -unity-text-align: middle-center;
    color: rgb(136, 136, 136);
    font-size: 12px;
}

.action-button:disabled {
    background-color: rgb(42, 42, 42);
    color: rgb(85, 85, 85);
    border-color: rgb(51, 51, 51);
}

.link-label {
    color: rgb(120, 190, 220);
    -unity-text-align: middle-right;
    cursor: link; 
}
.link-label:hover {
    color: rgb(40, 114, 143);
}
