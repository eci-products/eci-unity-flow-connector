/* Table 浏览：表头、数据行、单元格、滚动区域和本地差异状态。 */
.table-scroll-view {
    background-color: rgb(37, 37, 37);
    border-width: 1px;
    border-color: rgb(68, 68, 68);
    border-radius: 4px;
    max-height: 600px;
    overflow: scroll;
    flex-shrink: 1;
}

.table-header {
    flex-shrink: 0;
    align-self: flex-start;
    background-color: rgb(51, 51, 51);
    padding: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(68, 68, 68);
}

.table-content {
    flex-shrink: 0;
    align-self: flex-start;
    background-color: rgb(30, 30, 30);
}

.header-row {
    flex-direction: row;
    flex-shrink: 0;
    flex-grow: 0;
    align-self: flex-start;
    align-items: center;
}

.table-row {
    flex-direction: row;
    flex-shrink: 0;
    flex-grow: 0;
    align-self: flex-start;
    padding: 5px 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(51, 51, 51);
    align-items: center;
}

.table-row:hover {
    background-color: rgb(42, 42, 42);
}

.table-row-selected {
    background-color: rgb(64, 54, 38);
    border-left-width: 3px;
    border-left-color: rgb(207, 138, 111);
}

.header-key-cell {
    width: 100px;
    white-space: nowrap;
    overflow: hidden;
    color: rgb(147, 122, 85);
    font-size: 13px;
    -unity-font-style: bold;
    flex-shrink: 0;
    flex-grow: 0;
}

.header-cell {
    width: 278px;
    white-space: nowrap;
    overflow: hidden;
    color: rgb(83, 83, 83);
    font-size: 13px;
    -unity-font-style: bold;
    flex-shrink: 0;
    flex-grow: 0;
}

.table-cell {
    width: 200px;
    white-space: normal;
    color: rgb(204, 204, 204);
    font-size: 12px;
    flex-shrink: 0;
    flex-grow: 0;
}

.key-cell {
    width: 100px;
    white-space: nowrap;
    overflow: hidden;
    color: rgb(147, 122, 85);
    flex-shrink: 0;
    flex-grow: 0;
}

.status-section {
    background-color: rgb(30, 30, 30);
    border-width: 1px;
    border-color: rgb(68, 68, 68);
    border-radius: 4px;
    padding: 10px;
}

.status-content {
    margin-top: 5px;
}

.status-row {
    flex-direction: row;
    align-items: center;
    padding: 6px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgb(51, 51, 51);
}

.status-code-label {
    width: 60px;
    min-width: 60px;
    color: rgb(204, 204, 204);
    font-size: 12px;
    -unity-font-style: bold;
}

.progress-container {
    flex-grow: 1;
    height: 16px;
    background-color: rgb(45, 45, 45);
    border-radius: 8px;
    margin-left: 10px;
    margin-right: 10px;
    overflow: hidden;
}

.progress-bar {
    height: 100%;
    border-radius: 8px;
}

.progress-low {
    background-color: rgb(207, 111, 111);
}

.progress-half {
    background-color: rgb(207, 179, 111);
}

.progress-complete {
    background-color: rgb(111, 207, 151);
}

.progress-percent {
    width: 45px;
    min-width: 45px;
    color: rgb(147, 122, 85);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}


.toggle-left-checkbox .unity-toggle__input {
    position: absolute;
    left: 0;
    top: 50%;
    /* transform: translateY(-50%); */
}
.toggle-left-checkbox {
    position: relative;
    /* padding-left: 22px; 缂?checkbox 閻ｆ瑧鈹栭梻?*/
}

.table-cell-label {
    width: 70px;
    height: 20px;
    margin-bottom: 4px;
    margin-top: 4px;
    margin-right: 4px;
    margin-left: 4px;
    padding: 0;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-width: 1px;
    border-radius: 4px;
    font-size: 10px;
    flex-shrink: 0;
}

.table-cell-status-none {
    background-color: rgb(45, 45, 45);
    color: rgb(153, 153, 153);
    border-color: rgb(74, 74, 74);
}

.table-cell-status-clean {
    background-color: rgb(45, 74, 62);
    color: rgb(111, 207, 151);
    border-color: rgb(111, 207, 151);
}

.table-cell-status-changed {
    background-color: rgb(74, 66, 50);
    color: rgb(207, 179, 111);
    border-color: rgb(207, 179, 111);
}

